@model IEnumerable<ScheduleP.Models.Grupo>

@{
    ViewData["Title"] = "Index";
}

<h1>Grupos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NivelEducativo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NivelEducativo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdGrupo" class="btn btn-primary">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdGrupo" class="btn btn-success">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdGrupo" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
