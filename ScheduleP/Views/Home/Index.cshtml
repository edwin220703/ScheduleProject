@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido Al Gestos De Horarios</h1>
</div>

<div class="d-flex flex-row flex-nowrap gap-3 justify-content-center">
    <div class="card" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title">Horario</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">Para ingresar horarios</h6>
            <a class="nav-link text-primary" asp-area="" asp-controller="Horarios" asp-action="Consult">Horario Semanal</a>
        </div>
    </div>

    <div class="card" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title">Horario Consulta</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">para consultar</h6>
            <a class="nav-link text-primary" asp-area="" asp-controller="Horarios" asp-action="Index">Horarios</a>
        </div>
    </div>

    <div class="card" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title">Docente</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">Registro de docente</h6>
            <a class="nav-link text-primary" asp-area="" asp-controller="Docentes" asp-action="Index">Docentes</a>
        </div>
    </div>
</div>